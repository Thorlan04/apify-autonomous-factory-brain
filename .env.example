# ==============================================================================
# Clés API & Configurations - apify-autonomous-factory-brain
# ==============================================================================

# Clé API Google Gemini (gratuite sur https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Jeton d'accès API Apify (gratuit sur https://console.apify.com/account/integrations)
APIFY_API_TOKEN=apify_api_YourPersonalApifyTokenHere

# Référentiel GitHub du Cerveau (ex: username/apify-autonomous-factory-brain)
GITHUB_REPOSITORY=votre-compte/apify-autonomous-factory-brain

# Jeton d'accès GitHub (automatiquement fourni par GitHub Actions, ou Personal Access Token avec droits 'repo')
GITHUB_TOKEN=ghp_YourGitHubPersonalAccessTokenHere

# Configuration optionnelle pour l'exécution locale
FACTORY_ENV=production
LOG_LEVEL=INFO
